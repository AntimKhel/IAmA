{
  "name": "iama-api",
  "private": true,
  "description": "Visitor counter + guestbook API for the IAmA portfolio (Cloudflare Worker + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply iama --local && wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply iama --local",
    "db:remote": "wrangler d1 migrations apply iama --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
}
